{
  "include": [
    "NetscriptDefinitions.d.ts",
    "src/**/*.ts"
  ],
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noImplicitReturns": true,
    "noImplicitThis": true,
    "noEmit": true,
    "skipLibCheck": true,
    "paths": {
      "/*": [
        "./src/*"
      ],
      "@ns": [
        "./NetscriptDefinitions.d.ts"
      ]
    }
  }
}